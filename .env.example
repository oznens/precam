# --- Telegram ---
# Create a bot via @BotFather, then send /start to your bot once and fetch your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Solana data providers ---
# Free tier: https://dashboard.helius.dev/ (100k credits/day)
HELIUS_API_KEY=

# DexScreener is keyless (rate-limited per IP)
DEXSCREENER_BASE=https://api.dexscreener.com

# --- Runtime ---
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/precam.db
LOG_LEVEL=INFO

# Poll interval (seconds) for Twitter scanner
SCAN_INTERVAL=60

# Min liquidity USD to alert (filters obvious dust/rugs)
MIN_LIQUIDITY_USD=5000

# Max token age in minutes to flag as "EARLY" find
EARLY_MAX_AGE_MIN=720

# Smart-wallet realtime watcher
WATCHER_INTERVAL=90
WATCHER_MIN_BUY_USD=50
WATCHER_CONVERGENCE_WINDOW_MIN=60

# Helius webhooks (push-based watcher — replaces polling once configured)
# WEBHOOK_PUBLIC_URL must be reachable from the public internet over HTTPS.
# For local dev use a tunnel: `cloudflared tunnel --url http://localhost:8000`
# or `ngrok http 8000`. WEBHOOK_SECRET is a random string Helius will send
# back in an `Authorization` header so we can verify the source.
WEBHOOK_PUBLIC_URL=
WEBHOOK_SECRET=

# Paper-trade simulator (virtual portfolio against live signals)
PAPER_STARTING_BALANCE=1000
PAPER_POSITION_SIZE_USD=50
PAPER_MAX_CONCURRENT=10
PAPER_SLIPPAGE_PCT=1.0
PAPER_FEE_USD=0.50
PAPER_TP_PCT=100
PAPER_SL_PCT=-30
PAPER_MAX_HOLD_MIN=720
PAPER_INTERVAL=60

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
