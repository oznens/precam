# --- Telegram ---
# Create a bot via @BotFather, then send /start to your bot once and fetch your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Solana data providers ---
# Free tier: https://dashboard.helius.dev/ (100k credits/day)
HELIUS_API_KEY=

# DexScreener is keyless (rate-limited per IP)
DEXSCREENER_BASE=https://api.dexscreener.com

# --- Runtime ---
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/precam.db
LOG_LEVEL=INFO

# Poll interval (seconds) for Twitter scanner
SCAN_INTERVAL=60

# Min liquidity USD to alert (filters obvious dust/rugs)
MIN_LIQUIDITY_USD=5000

# Max token age in minutes to flag as "EARLY" find
EARLY_MAX_AGE_MIN=720

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
